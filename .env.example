# ── Supabase (Project Settings → API) ───────────────────────────
# URL del proyecto, ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (o la "publishable"). Es segura en el navegador:
# Row Level Security decide qué puede ver cada usuario.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── IA (opcional) ────────────────────────────────────────────────
# Se usa el primer proveedor configurado. Sin ninguno la app funciona igual:
# plan por plantilla, progresión determinista, sin recetas ni lectura de .txt.
# Las claves viven solo en el servidor.
#
# Groq (recomendado): gratis sin tarjeta en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini (alternativa): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Opcional ────────────────────────────────────────────────────
# Zona horaria para decidir qué día es "hoy"
TZ_APP=America/Argentina/Buenos_Aires
