# ── Supabase (Project Settings → API) ───────────────────────────
# URL del proyecto, ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (o la "publishable"). Es segura en el navegador:
# Row Level Security decide qué puede ver cada usuario.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── IA (opcional) ────────────────────────────────────────────────
# Se usa el primer proveedor configurado. Sin ninguno la app funciona igual:
# plan por plantilla, progresión determinista, sin recetas ni lectura de .txt.
# Las claves viven solo en el servidor.
#
# Groq (recomendado): gratis sin tarjeta en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini (alternativa): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Opcional ────────────────────────────────────────────────────
# Zona horaria para decidir qué día es "hoy"
TZ_APP=America/Mexico_City
# Precio del mes en dólares que ve el cliente al pagar (por defecto 50)
PLAN_PRECIO_USD=50

# ── Notificaciones push (opcional) ───────────────────────────────
# Generá las claves una vez con: npx web-push generate-vapid-keys
# Sin ellas la app funciona igual, solo no manda avisos al teléfono.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
# Cualquier texto largo al azar: protege la ruta /api/cron/avisos
CRON_SECRET=
