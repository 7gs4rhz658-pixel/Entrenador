# ── Supabase (Project Settings → API) ───────────────────────────
# URL del proyecto, ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (o la "publishable"). Es segura en el navegador:
# Row Level Security decide qué puede ver cada usuario.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Gemini (IA) ─────────────────────────────────────────────────
# Clave gratis en https://aistudio.google.com/apikey. Vive solo en el
# servidor. Sin ella la app funciona igual: plan por plantilla,
# progresión determinista, sin recetas ni lectura de .txt.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Opcional ────────────────────────────────────────────────────
# Zona horaria para decidir qué día es "hoy"
TZ_APP=America/Argentina/Buenos_Aires
